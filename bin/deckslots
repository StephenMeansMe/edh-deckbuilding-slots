#!/usr/bin/env python3
"""Standalone entrypoint for deckslots REPL."""

import sys
from pathlib import Path

# Ensure src/ is on the path when running directly from bin/
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from deckslots.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
